<script>

/* ==========================
DATA
========================== */

let customers=
JSON.parse(
localStorage.getItem("willpowerCustomers")||"[]"
);

let products=
JSON.parse(
localStorage.getItem("willpowerProducts")||"[]"
);

let invoices=
JSON.parse(
localStorage.getItem("willpowerInvoices")||"[]"
);

let payments=
JSON.parse(
localStorage.getItem("willpowerPayments")||"[]"
);

let currentInvoiceId=null;


/* ==========================
NAVIGATION
========================== */

function openPage(pageId,button){

document
.querySelectorAll(".page")
.forEach(p=>p.classList.remove("active"));

document
.getElementById(pageId)
.classList.add("active");

document
.querySelectorAll(".menu button")
.forEach(b=>b.classList.remove("active"));

if(button){
button.classList.add("active");
}

if(pageId==="customersPage"){
displayCustomers();
}

if(pageId==="productsPage"){
displayProducts();
}

if(pageId==="invoicesPage"){
displayInvoices();
}

if(pageId==="accountsPage"){
prepareAccounts();
}

}


/* ==========================
INVOICE NUMBER
========================== */

function nextInvoiceNumber(){

let n=
Number(
localStorage.getItem(
"willpowerInvoiceNumber"
)||0
);

n++;

localStorage.setItem(
"willpowerInvoiceNumber",
n
);

return "WWPL/"
+String(n).padStart(4,"0");

}


/* ==========================
NEW INVOICE
========================== */

function newInvoice(){

currentInvoiceId=null;

document.getElementById("invoiceNumber")
.value=nextInvoiceNumber();

document.getElementById("invoiceDate")
.value=
new Date()
.toISOString()
.split("T")[0];

document.getElementById("invoiceStatus")
.value="Draft";

document.getElementById("paymentTerms")
.value=
"100% Advance Payment";

document.getElementById("creditPeriod")
.value="";

document.getElementById("creditRow")
.style.display="none";

document.getElementById("buyerName").value="";
document.getElementById("buyerAddress").value="";
document.getElementById("buyerState").value="";
document.getElementById("buyerGST").value="";
document.getElementById("buyerContact").value="";

populateCustomerSelect();

document.getElementById("invoiceCustomer")
.value="";

document.getElementById("invoiceProducts")
.innerHTML="";

addInvoiceProduct();

openPage("invoicePage");

}


/* ==========================
CUSTOMERS
========================== */

function addCustomer(){

const name=
document.getElementById("customerName")
.value.trim();

if(!name){

alert("Enter customer name.");

return;

}

customers.push({

name:name,

address:
document.getElementById("customerAddress").value,

state:
document.getElementById("customerState").value,

gst:
document.getElementById("customerGST").value,

contact:
document.getElementById("customerContact").value

});

localStorage.setItem(
"willpowerCustomers",
JSON.stringify(customers)
);

document.getElementById("customerName").value="";
document.getElementById("customerAddress").value="";
document.getElementById("customerState").value="";
document.getElementById("customerGST").value="";
document.getElementById("customerContact").value="";

displayCustomers();

populateCustomerSelect();

alert("Customer added.");

}


function displayCustomers(){

const tbody=
document.getElementById("customerTable");

const search=
(
document.getElementById("customerSearch")
?.value||""
).toLowerCase();

tbody.innerHTML="";

customers.forEach((c,i)=>{

if(
search &&
!c.name.toLowerCase().includes(search)&&
!(c.gst||"").toLowerCase().includes(search)&&
!(c.contact||"").toLowerCase().includes(search)
){
return;
}

const row=
document.createElement("tr");

row.innerHTML=`

<td>${safe(c.name)}</td>
<td>${safe(c.address)}</td>
<td>${safe(c.state)}</td>
<td>${safe(c.gst)}</td>
<td>${safe(c.contact)}</td>

<td>

<button
onclick="editCustomer(${i})">
Edit
</button>

<button
class="btn-danger"
onclick="deleteCustomer(${i})">
Delete
</button>

</td>

`;

tbody.appendChild(row);

});


}


function editCustomer(index){

const c=customers[index];

const name=prompt(
"Customer Name:",
c.name
);

if(name===null)return;

const address=prompt(
"Address:",
c.address
);

if(address===null)return;

const state=prompt(
"State:",
c.state
);

if(state===null)return;

const gst=prompt(
"GSTIN:",
c.gst
);

if(gst===null)return;

const contact=prompt(
"Contact:",
c.contact
);

if(contact===null)return;

customers[index]={
name:name,
address:address,
state:state,
gst:gst,
contact:contact
};

localStorage.setItem(
"willpowerCustomers",
