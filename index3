function displayLedger(){

const tbody=
document.getElementById(
"ledgerTable"
);

const index=
document.getElementById(
"ledgerCustomer"
).value;

tbody.innerHTML="";

if(index==="")return;

const customerIndex=
Number(index);

let balance=0;

const entries=[];


/* CREDIT INVOICES */

invoices.forEach(invoice=>{

if(
Number(invoice.customerIndex)
===customerIndex &&
invoice.payment==="Credit" &&
invoice.status!=="Cancelled"
){

entries.push({

date:invoice.date,

reference:invoice.number,

description:"Credit Invoice",

debit:Number(invoice.amount)||0,

credit:0

});

}

});


/* PAYMENTS */

payments.forEach(payment=>{

if(
Number(payment.customerIndex)
===customerIndex
){

entries.push({

date:payment.date,

reference:payment.reference||"",

description:"Payment Received",

debit:0,

credit:Number(payment.amount)||0

});

}

});


entries.sort(
(a,b)=>
new Date(a.date)-new Date(b.date)
);


entries.forEach(entry=>{

balance+=entry.debit;
balance-=entry.credit;

const row=
document.createElement("tr");

row.innerHTML=`

<td>${safe(entry.date)}</td>

<td>${safe(entry.reference)}</td>

<td>${safe(entry.description)}</td>

<td>₹${entry.debit.toFixed(2)}</td>

<td>₹${entry.credit.toFixed(2)}</td>

<td>
₹${balance.toFixed(2)}
</td>

`;

tbody.appendChild(row);

});


if(!entries.length){

const row=
document.createElement("tr");

row.innerHTML=
`<td colspan="6">
No ledger entries.
</td>`;

tbody.appendChild(row);

}

}


/* ==========================
ACCOUNT TOTALS
========================== */

function calculateAccounts(){

let sales=0;
let creditSales=0;
let collections=0;

invoices.forEach(invoice=>{

if(invoice.status==="Cancelled")return;

sales+=Number(invoice.amount)||0;

if(invoice.payment==="Credit"){

creditSales+=
Number(invoice.amount)||0;

}

});


payments.forEach(payment=>{

collections+=
Number(payment.amount)||0;

});


const outstanding=
creditSales-collections;

return{
sales,
creditSales,
collections,
outstanding:Math.max(
0,
outstanding
)
};

}


