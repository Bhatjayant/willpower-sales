<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Willpower Sales & Accounts V3</title>

<style>
*{box-sizing:border-box}

body{
    margin:0;
    font-family:Arial,Helvetica,sans-serif;
    background:#f2f2f2;
    color:#111;
}

.app{
    max-width:1400px;
    margin:auto;
    min-height:100vh;
    background:#fff;
}

.topbar{
    background:#111;
    color:#fff;
    padding:14px 20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.brand{
    font-size:21px;
    font-weight:bold;
}

.subtitle{
    font-size:11px;
    opacity:.7;
    margin-top:3px;
}

.menu{
    display:flex;
    gap:5px;
    flex-wrap:wrap;
}

.menu button{
    background:#333;
    color:#fff;
    border:0;
    padding:9px 13px;
    cursor:pointer;
}

.menu button.active,
.menu button:hover{
    background:#fff;
    color:#111;
}

.page{
    display:none;
    padding:22px;
}

.page.active{
    display:block;
}

.page-title{
    margin:0 0 18px;
    font-size:22px;
}

button{
    border:0;
    background:#111;
    color:#fff;
    padding:9px 15px;
    cursor:pointer;
}

button:hover{
    opacity:.85;
}

.btn-danger{
    background:#900;
}

.btn-success{
    background:#176117;
}

.btn-secondary{
    background:#555;
}

.dashboard{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.card{
    border:1px solid #ccc;
    padding:18px;
}

.card-title{
    font-size:11px;
    color:#666;
}

.card-value{
    font-size:24px;
    font-weight:bold;
    margin-top:8px;
}

.section{
    border:1px solid #ccc;
    margin-bottom:18px;
}

.section-title{
    background:#111;
    color:#fff;
    padding:9px 12px;
    font-size:13px;
    font-weight:bold;
}

.section-body{
    padding:15px;
}

.form-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:12px;
}

.form-group label{
    display:block;
    font-size:11px;
    margin-bottom:5px;
    font-weight:bold;
}

input,
select{
    width:100%;
    padding:9px;
    border:1px solid #aaa;
    font-size:13px;
}

.table-wrap{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,
td{
    border:1px solid #ccc;
    padding:8px;
    font-size:12px;
}

th{
    background:#eee;
}

.search{
    margin-bottom:12px;
}

.search input{
    max-width:450px;
}

/* ACCOUNT SUMMARY */

.account-summary{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
    margin-bottom:20px;
}

/* LEDGER */

.ledger-box{
    margin-top:20px;
}

.positive{
    font-weight:bold;
}

.outstanding{
    font-weight:bold;
}

/* INVOICE */

.invoice-head{
    display:grid;
    grid-template-columns:120px 1fr 320px;
    gap:20px;
    border-bottom:2px solid #111;
    padding-bottom:15px;
}

.logo{
    text-align:center;
}

.logo-symbol{
    font-size:48px;
    font-weight:bold;
}

.logo-name{
    font-size:10px;
    font-weight:bold;
}

.company-name{
    font-size:20px;
    font-weight:bold;
    margin-bottom:8px;
}

.company-details{
    font-size:11px;
    line-height:1.5;
}

.invoice-meta{
    border-left:1px solid #ccc;
    padding-left:15px;
}

.invoice-meta h2{
    margin:0 0 12px;
    text-align:right;
}

.meta-row{
    display:grid;
    grid-template-columns:110px 1fr;
    gap:8px;
    margin-bottom:7px;
}

.meta-row label{
    font-size:11px;
    font-weight:bold;
}

.buyer-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
}

.box{
    border:1px solid #ccc;
    padding:14px;
}

.box h3{
    font-size:12px;
    margin:0 0 10px;
}

.box input,
.box select{
    margin-bottom:7px;
}

.invoice-table{
    margin-top:15px;
    overflow-x:auto;
}

.invoice-table table{
    min-width:1050px;
}

.invoice-table input,
.invoice-table select{
    padding:6px;
}

.summary{
    display:grid;
    grid-template-columns:1fr 350px;
    gap:15px;
    margin-top:15px;
}

.words{
    border:1px solid #ccc;
    padding:14px;
    font-size:12px;
}

.totals{
    border:1px solid #ccc;
}

.total-row{
    display:flex;
    justify-content:space-between;
    padding:9px;
    border-bottom:1px solid #ddd;
    font-size:12px;
}

.total-final{
    font-size:17px;
    font-weight:bold;
}

.credit-row{
    display:none;
}

.actions{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    margin-top:12px;
}

@media(max-width:900px){

    .dashboard,
    .account-summary{
        grid-template-columns:1fr 1fr;
    }

    .invoice-head,
    .buyer-grid,
    .summary{
        grid-template-columns:1fr;
    }

    .invoice-meta{
        border-left:0;
        padding-left:0;
    }

    .invoice-meta h2{
        text-align:left;
    }

    .form-grid{
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:600px){

    .topbar{
        display:block;
    }

    .menu{
        margin-top:12px;
    }

    .menu button{
        flex:1;
    }

    .dashboard,
    .account-summary,
    .form-grid{
        grid-template-columns:1fr;
    }

    .page{
        padding:12px;
    }
}

@media print{

    .topbar,
    .no-print{
        display:none!important;
    }

    #invoicePage{
        display:block!important;
    }

    .page{
        padding:0;
    }
}
</style>
</head>

